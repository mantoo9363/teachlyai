
# See https://help.github.com/articles/ignoring-files/

# Dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Public videos
/public/videos/

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build
/dist

# Misc
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Environment variables - NEVER COMMIT SECRETS
.env
.env.*
env
**/.env
**/.env.*

# Allow safe example templates
!.env.example
!**/.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# VS Code
.vscode/

# Temporary files
*.tmp
*.zip
config.bat
